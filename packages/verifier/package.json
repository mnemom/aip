{
  "name": "@mnemom/aip-verifier",
  "version": "0.6.2",
  "description": "Offline verification of AIP integrity certificates — Ed25519 signatures, chain hashes, and Merkle proofs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./render-lines": {
      "import": {
        "types": "./dist/render-lines.d.ts",
        "default": "./dist/render-lines.js"
      },
      "require": {
        "types": "./dist/render-lines.d.cts",
        "default": "./dist/render-lines.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "fixtures": "RECORD_FIXTURES=write vitest run test/record-fixtures.test.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "integrity",
    "verification",
    "certificate",
    "ed25519",
    "merkle",
    "offline"
  ],
  "author": "Mnemom.ai",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mnemom/aip#readme",
  "bugs": {
    "url": "https://github.com/mnemom/aip/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mnemom/aip.git",
    "directory": "packages/verifier"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@mnemom/sdk": "^1.1.0",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
